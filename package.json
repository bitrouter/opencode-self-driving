{
  "name": "opencode-self-driving",
  "version": "0.7.0-dev.0",
  "description": "Automatically connect existing OpenCode models to a local BitRouter",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitrouter/opencode-self-driving.git"
  },
  "exports": {
    ".": { "types": "./dist/server.d.ts", "default": "./server.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./server.js" },
    "./rpc": { "types": "./dist/rpc.d.ts", "default": "./rpc.js" }
  },
  "files": ["dist", "server.js", "rpc.js", "README.md", "docs/configuration.md", "docs/installation.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun script/build.ts && tsc -p tsconfig.build.json",
    "test": "bun script/test.ts",
    "check": "bun run build && bun run test",
    "prepack": "bun run build"
  },
  "peerDependencies": { "@opencode/plugin": "2.3.2" },
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "@opencode/plugin": "2.3.2",
    "@opencode/sdk": "2.3.2",
    "@types/bun": "1.4.3",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
